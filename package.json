{
  "name": "kakao-chat-viewer",
  "version": "2.1.7",
  "description": "KakaoTalk macOS 聊天记录查看与导出（Mac App，全自动解密）",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "python3 serve.py",
    "test": "npm run test:boundary",
    "test:boundary": "node electron/media.boundary.test.cjs && node js/messageParser.boundary.test.mjs",
    "test:media": "node electron/media.selftest.cjs && node electron/media.boundary.test.cjs",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.vorssaint.kakaochatviewer",
    "productName": "KakaoChat Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "js/**/*",
      "vendor/**/*",
      "css/**/*",
      "index.html",
      "!electron/**/*.test.cjs",
      "!electron/**/*.selftest.cjs",
      "!js/**/*.test.mjs",
      "!js/**/*.boundary.test.mjs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "KakaoChat-Viewer-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KakaoChat-Viewer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "KakaoChat-Viewer-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
